{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TutorContext": "Host=localhost;Port=5432;Database=tutor-api;Username=postgres;Password=P@ssword1;"
  },
  "Smtp": {
    "SmtpHost": "",
    "SmtpPort": 0,
    "SmtpUser": "",
    "SmtpPass": "",
    "FromEmail": ""
  },
  "JWT": {
    "Issuer": "TutorApi",
    "Audience": "TutorApi;TutorApiApp",
    "AccessTokenExpirationMinutes": 5,
    "RefreshTokenExpirationDays": 7,
    "SecretKey": "For the test purpose, it is saved here. It should move to a safe place."
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.File", "Serilog.Expressions"],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["WithThreadId", "FromLogContext", "WithMachineName"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Verbose",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u4}]<{ThreadId}> [{SourceContext:l}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByExcluding",
                "Args": {
                  "expression": "LogStream = 'Mobile'"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "Log/Backend/log-.log",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 7,
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u4}]<{ThreadId}> [{SourceContext:l}] {Message:lj}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "LogStream = 'Mobile'"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "Log/Frontend/log-.log",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 7,
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u4}]<{ThreadId}> [{SourceContext:l}] {Message:lj}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      }
    ]
  }
}
