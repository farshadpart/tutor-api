Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..c-Av5izBAQEdko5B7nlihkOiId1ujQPJv5KfDZFD3Gc
Accept: application/json
{
  "userId": "47c14339-c7b3-47c7-82d5-fe19addc542c",
  "subscriptionTypeId": "Basic"
}
