@TutorApi_HostAddress = http://192.168.2.103:5252

### Create a new subscription for the user
POST {{TutorApi_HostAddress}}/subscription/create
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..v6jCWsNTJn8nfhSVYbr6g8YPnQCS7Lh_OMkYh2HYb-g
Accept: application/json
{
  "userId": "abdcb0ae-90e3-489c-a567-a78b2c5ce926",
  "subscriptionTypeId": "Basic"
}
