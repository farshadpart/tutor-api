@model Tutor.Api.Models.Account.EmailConfirmationViewModel

@{
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <meta name="color-scheme" content="light">
    <title>@Model.Title | Tutor</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background:
                radial-gradient(circle at 20% 20%, rgba(226, 184, 79, 0.22), transparent 30%),
                linear-gradient(135deg, #eef3f0 0%, #f8f6eb 100%);
            color: #17221c;
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            line-height: 1.5;
        }

        .page {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 32px 16px;
        }

        .shell {
            width: min(100%, 640px);
        }

        .brand {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 18px;
            color: #17221c;
        }

        .brand-mark {
            display: inline-grid;
            width: 42px;
            height: 42px;
            place-items: center;
            border-radius: 12px;
            background: #1f6f52;
            color: #ffffff;
            font-size: 21px;
            font-weight: 800;
        }

        .brand-name {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 20px;
            font-weight: 800;
        }

        .context {
            color: #58655d;
            font-size: 14px;
            font-weight: 700;
        }

        .card {
            overflow: hidden;
            border: 1px solid #dce6df;
            border-radius: 24px;
            background: #ffffff;
            box-shadow: 0 22px 60px rgba(26, 54, 42, 0.14);
        }

        .stripe {
            height: 8px;
            background: linear-gradient(90deg, #1f6f52, #e2b84f);
        }

        .content {
            padding: clamp(28px, 6vw, 48px);
        }

        .status {
            width: 68px;
            height: 68px;
            display: grid;
            place-items: center;
            border-radius: 18px;
            margin-bottom: 24px;
        }

        .status-success {
            background: #eef8f2;
            color: #1f6f52;
        }

        .status-error {
            background: #fff1f1;
            color: #a63d3d;
        }

        .eyebrow {
            margin: 0 0 10px;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 0;
            text-transform: uppercase;
        }

        .status-success + .eyebrow {
            color: #1f6f52;
        }

        .status-error + .eyebrow {
            color: #a63d3d;
        }

        h1 {
            margin: 0 0 14px;
            font-size: clamp(32px, 6vw, 46px);
            line-height: 1.08;
            letter-spacing: 0;
        }

        .message {
            margin: 0;
            color: #58655d;
            font-size: clamp(17px, 3vw, 20px);
        }

        .guidance {
            margin: 28px 0 0;
            padding: 18px 20px;
            border: 1px solid #e1e9e3;
            border-radius: 16px;
            background: #f7faf7;
            color: #465249;
            font-size: 15px;
        }

        .footer {
            margin-top: 18px;
            color: #78857d;
            font-size: 13px;
            text-align: center;
        }

        @@media (max-width: 520px) {
            .brand {
                align-items: flex-start;
                flex-direction: column;
            }

            .content {
                padding: 28px 22px;
            }
        }
    </style>
</head>
<body>
    <main class="page">
        <section class="shell" aria-labelledby="confirmation-title">
            <div class="brand" aria-label="Tutor">
                <div class="brand-name">
                    <span class="brand-mark" aria-hidden="true">T</span>
                    <span>Tutor</span>
                </div>
                <div class="context">Account security</div>
            </div>
            <article class="card">
                <div class="stripe" aria-hidden="true"></div>
                <div class="content">
                    @if (Model.IsSuccess)
                    {
                        <div class="status status-success" aria-hidden="true">
                            <svg width="34" height="34" viewBox="0 0 24 24" fill="none">
                                <path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                    }
                    else
                    {
                        <div class="status status-error" aria-hidden="true">
                            <svg width="34" height="34" viewBox="0 0 24 24" fill="none">
                                <path d="M12 8v5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                                <path d="M12 17h.01" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                                <path d="M10.3 4.3 2.8 17.2A2 2 0 0 0 4.5 20h15a2 2 0 0 0 1.7-2.8L13.7 4.3a2 2 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                            </svg>
                        </div>
                    }
                    <p class="eyebrow">@Model.Eyebrow</p>
                    <h1 id="confirmation-title">@Model.Title</h1>
                    <p class="message">@Model.Message</p>
                    <p class="guidance">@Model.Guidance</p>
                </div>
            </article>
            <p class="footer">This page can be closed after you return to Tutor.</p>
        </section>
    </main>
</body>
</html>
